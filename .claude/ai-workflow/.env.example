# 复制为同目录 .env 并填值（.env 已被 .claude/.gitignore 覆盖，不入库）。
# 控制面（Go 后端）按「进程环境变量 > 本文件 > 默认」的优先级读取这些键。
# 生成随机 token：openssl rand -hex 32

# ── 票源（jira / linear 二选一）──────────────────────────
# 也可在 config.json 顶层写 "source"；本键用于覆盖。
SOURCE=jira

# JIRA 凭据（jira_api.py 读取；JIRA 源时必填）
ATLASSIAN_USERNAME=
ATLASSIAN_API_KEY=
ATLASSIAN_DOMAIN=
JIRA_PROJECT=

# Linear（Linear 源时必填）：Personal API Key + 可选团队 key（如 ENG）
LINEAR_API_KEY=
LINEAR_TEAM=

# ── 控制面 HTTP ─────────────────────────────────────────
# 监听端口（前端 dev 代理默认指向 8788，见 frontend/vite.config.ts 的 VITE_BACKEND）
PORT=8788

# skill 经 /internal 回传事件的共享 token（runner 注入到 worktree，必填）
INTERNAL_TOKEN=

# 多租户凭据加密主密钥（AES-256-GCM 派生源）。多租户下必配、且勿更换——
# 换了旧租户凭据无法解密。留空则禁用按租户凭据存储（仅单机开发）。生成：openssl rand -hex 32
MASTER_KEY=

# ── 运行期 ─────────────────────────────────────────────
# claude CLI 路径（默认取 PATH 中的 claude）
# CLAUDE_BIN=/Users/carlos/.local/bin/claude

# gh CLI 路径（默认 gh）
# GH_BIN=gh

# worktree 隔离基目录
# WORKTREE_BASE=/tmp/wf-worktrees

# SQLite 任务库路径（默认 .claude/ai-workflow/tasks.db）
# DB_PATH=

# Slack 通知 webhook（可空；为空则不发）
# SLACK_WEBHOOK_URL=

# ── M7 调度 Agent ──────────────────────────────────────
# 总开关（默认 true；false=关闭聊天窗与事件唤醒）
# AGENT_ENABLED=true

# Agent 会话模型（空=claude CLI 默认；如 sonnet / opus）
# 塔台通用能力：保留 claude 内建工具（Bash/联网等，≈本地终端）。多租户互不信任时设 false 收紧为纯 MCP 沙箱。默认 true。
# AGENT_GENERAL=true
# 塔台交接班：班次超时长（小时）或消息量即新开会话（带交接摘要），控 token 与旧记忆干扰
# AGENT_HANDOVER_H=24
# AGENT_HANDOVER_MSGS=300
# AGENT_MODEL=

# 会话空闲回收分钟数（默认 30；会话 id 已持久化，回收后自动 resume）
# AGENT_IDLE_MIN=30

# 人审滞留提醒阈值（小时，默认 24；PR 审查闸口自动翻倍；0=关闭提醒）
# AGENT_REVIEW_REMIND_H=24

# 写工具自动执行白名单（逗号分隔）。人审闸口（approve_issue/approve_pr）恒需人工确认，配了也不放行。
# AGENT_AUTO_ACTIONS=cancel_task,restart_task,request_revise

# Agent 会话工作目录（默认 /tmp/wf-agent，按租户隔离）
# AGENT_DIR=/tmp/wf-agent
