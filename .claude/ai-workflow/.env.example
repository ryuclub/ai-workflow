# 复制为同目录 .env 并填值（.env 已被 .claude/.gitignore 覆盖，不入库）。
# 生成随机密钥：openssl rand -hex 32

# GitHub webhook 的 Secret（注册 webhook 时填同一串，用于 HMAC-SHA256 验签）
GITHUB_WEBHOOK_SECRET=

# JIRA Automation「发送 web 请求」时自定义 header X-Webhook-Token 的值（填同一串）
JIRA_WEBHOOK_TOKEN=

# JIRA 触发状态名（票转到此状态即触发 B）
JIRA_TRIGGER_STATUS=待AI处理
# JIRA 工单号校验正则（默认接受任意项目键 ABC-123；收窄到单项目设如 ^PROJ-\d+$）
# JIRA_ID_PATTERN=^[A-Z][A-Z0-9]+-\d+$
# JIRA 读取验证用的工单号（setup.sh 用；不填则跳过该项验证）
# JIRA_TEST_KEY=PROJ-1234

# ── Linear（可选，与 JIRA 并行的另一入口）──
# Linear webhook 的 Signing secret（Settings → API → Webhooks，用于 HMAC-SHA256 验签）
LINEAR_WEBHOOK_SECRET=
# Linear Personal API Key（Settings → API → Personal API keys，接收器/skill 读票用）
LINEAR_API_KEY=
# Linear 触发标签名（issue 打此标签即触发 B）
LINEAR_TRIGGER_LABEL=AI处理
# Linear 工单号校验正则（默认兼容 TEAM-数字；一般无需改）
# LINEAR_ID_PATTERN=^[A-Z][A-Z0-9]+-\d+$

# 已审核标签名（Issue 打此标签即触发 C）
APPROVED_LABEL=已审核

# 监听端口
PORT=8787

# 仓库根（默认推断为本仓；如接收器移位需显式指定绝对路径）
# REPO_DIR=/abs/path/to/ai-workflow

# claude CLI 路径（默认取 PATH 中的 claude）
# CLAUDE_BIN=/abs/path/to/claude

# worktree 隔离基目录
# WORKTREE_BASE=/tmp/wf-worktrees
