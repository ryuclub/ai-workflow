{
   "permissions": {
    "allow": [
      "Bash(go run *)",
      "Bash(go build *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-review.sh"
          }
        ]
      }
    ]
  }
}
