# Atlassian API 认证信息
# 请复制此文件并创建 .env:
#   cp .env.example .env
#
# API Token 获取: https://id.atlassian.com/manage-profile/security/api-tokens

ATLASSIAN_USERNAME=your-email@example.com
ATLASSIAN_API_KEY=your-api-token
ATLASSIAN_DOMAIN=your-domain.atlassian.net

JIRA_PROJECT=

# 实例特有字段（可选，留空则新建工单时不设置这些字段）
# 字段 ID 与取值因 JIRA 实例而异，可在「项目设置 → 字段」中查到
# JIRA_TEAM_FIELD   团队字段 ID，形如 customfield_1XXXX
# JIRA_TEAM_ID      团队字段取值（实例特有 UUID）
# JIRA_SYSTEM_FIELD 系统字段 ID，形如 customfield_1XXXX
# JIRA_SYSTEM_ID    系统字段取值 ID
# JIRA_VERSION_PREFIX 修复版本名前缀，设置后自动取该前缀最新未发布版本
JIRA_TEAM_FIELD=
JIRA_TEAM_ID=
JIRA_SYSTEM_FIELD=
JIRA_SYSTEM_ID=
JIRA_VERSION_PREFIX=
